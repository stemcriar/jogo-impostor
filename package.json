{
  "name": "jogo-impostor",
  "version": "1.0.0",
  "description": "Impostor de Turing - Jogo interativo para o projeto STEM Criar",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch src/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && node src/index.js",
    "test": "cd server && npx vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
